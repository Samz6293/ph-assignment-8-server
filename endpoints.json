{
  "message": "API Working",
  "baseurl": "http://localhost:8080",
  "endpoints": [
    {
      "path": "/events",
      "method": "POST",
      "description": "Create a new event (JSON body)"
    },
    {
      "path": "/events/previous",
      "method": "GET",
      "description": "Get events whose date has passed"
    },
    {
      "path": "/events/upcoming",
      "method": "GET",
      "description": "Get upcoming events sorted by date",
      "query": { "limit": "Optional max number of events to return" }
    },
    {
      "path": "/event-details/:id",
      "method": "GET",
      "description": "Get a single event by its ID"
    },
    {
      "path": "/manage-events/:id",
      "method": "GET",
      "description": "Get all events hosted by the given host ID, sorted by date"
    },
    {
      "path": "/events/:id",
      "method": "DELETE",
      "description": "Delete an event by its ID"
    },
    {
      "path": "/events",
      "method": "GET",
      "description": "Get all events"
    },
    {
      "path": "/events/:id",
      "method": "PATCH",
      "description": "Update an event by its ID (JSON body)"
    },
    {
      "path": "/events/:id/join",
      "method": "PATCH",
      "description": "Join an event (JSON body: userId, name, email, image)"
    },
    {
      "path": "/events/:id/leave",
      "method": "PATCH",
      "description": "Leave an event (JSON body: userId)"
    },
    {
      "path": "/joined-events/:userId",
      "method": "GET",
      "description": "Get all events the given user joined, sorted by date"
    }
  ]
}
